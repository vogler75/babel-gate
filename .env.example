# BabelGate / LLM-Router Environment Configuration
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# Google Gemini API Key (used by providers.google in config.example.yaml)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude API Key (used by providers.anthropic in config.example.yaml)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (used by providers.openai in config.example.yaml)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Copilot Token (optional: overrides local ~/.config/github-copilot credentials)
# GITHUB_TOKEN=your_github_token_here
# COPILOT_API_KEY=your_copilot_token_here

# Server Settings (optional)
# PORT=8080
# ROUTER_API_KEY=router-secret-key
